PORT=3000
SESSION_SECRET=change-this-to-any-random-text

# Only needed when deploying to a host like Render: point this at the
# persistent disk mount path so the database survives redeploys.
# Leave commented out for local use on your own computer.
# DATA_DIR=/data

# Platform owner login (http://localhost:3000/system-admin) — lists every
# subscribed showroom and lets you suspend/reactivate them. Not tied to any
# showroom's own accounts. Leave unset to disable this panel entirely.
SYSTEM_ADMIN_USERNAME=owner
SYSTEM_ADMIN_PASSWORD=change-this-to-a-strong-password
