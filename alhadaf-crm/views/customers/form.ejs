<!doctype html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', { title: customer && customer.id ? 'تعديل عميل' : 'إضافة عملية بيع' }) %></head>
<body>
  <%- include('../partials/nav', { active: 'new' }) %>
  <main class="page container">
    <div class="section-title"><span class="bar"></span> <%= customer && customer.id ? 'تعديل بيانات عملية البيع' : 'إضافة عملية بيع جديدة' %></div>

    <% if (typeof added !== 'undefined' && added) { %>
      <div class="flash flash-success" style="margin-bottom:16px">تمت إضافة عملية البيع بنجاح ✅</div>
    <% } %>

    <form class="card" method="POST" action="<%= customer && customer.id ? '/customers/' + customer.id : '/customers' %>">
      <% if (customer && customer.from_prospect_id) { %>
        <input type="hidden" name="from_prospect_id" value="<%= customer.from_prospect_id %>">
        <div class="flash flash-success" style="margin-bottom:16px">تعبئة تلقائية من عميل محتمل — أكمل باقي بيانات البيع.</div>
      <% } %>

      <div class="field">
        <label>نوع العميل *</label>
        <div class="form-row" style="gap:20px">
          <label style="display:flex; align-items:center; gap:6px; font-weight:400">
            <input type="radio" name="customer_type" value="رخصة واستمارة" id="typeLicense"
              <%= !(customer && customer.customer_type === 'معارض') ? 'checked' : '' %>> رخصة واستمارة
          </label>
          <label style="display:flex; align-items:center; gap:6px; font-weight:400">
            <input type="radio" name="customer_type" value="معارض" id="typeDealer"
              <%= (customer && customer.customer_type === 'معارض') ? 'checked' : '' %>> معارض
          </label>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label id="labelCustomerName">اسم العميل *</label>
          <input type="text" name="customer_name" value="<%= customer ? customer.customer_name || '' : '' %>" class="<%= errors.customer_name ? 'invalid' : '' %>" required>
          <% if (errors.customer_name) { %><div class="err"><%= errors.customer_name %></div><% } %>
        </div>
        <div class="field">
          <label id="labelNationalId">رقم الهوية (10 أرقام) *</label>
          <input type="text" name="national_id" id="nationalIdInput" inputmode="numeric" maxlength="10" value="<%= customer ? customer.national_id || '' : '' %>" class="<%= errors.national_id ? 'invalid' : '' %>" required>
          <% if (errors.national_id) { %><div class="err"><%= errors.national_id %></div><% } %>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>رقم جوال العميل (05xxxxxxxx)</label>
          <input type="text" name="phone" inputmode="numeric" maxlength="10" value="<%= customer ? customer.phone || '' : '' %>" class="<%= errors.phone ? 'invalid' : '' %>">
          <% if (errors.phone) { %><div class="err"><%= errors.phone %></div><% } %>
        </div>
        <div class="field">
          <label>طريقة الدفع *</label>
          <select name="payment_method" id="paymentSelect" class="<%= errors.payment_method ? 'invalid' : '' %>">
            <option value="">اختر...</option>
            <% PAYMENT_METHODS.forEach(m => { %>
              <option value="<%= m %>" <%= customer && customer.payment_method===m ? 'selected':'' %>><%= m %></option>
            <% }) %>
          </select>
          <input type="text" id="paymentDealerDisplay" value="نقدي" disabled style="display:none">
          <input type="hidden" name="payment_method" id="paymentDealerHidden" value="نقدي" disabled>
          <% if (errors.payment_method) { %><div class="err"><%= errors.payment_method %></div><% } %>
        </div>
      </div>

      <div class="form-row" id="bankRow" style="display:none">
        <div class="field">
          <label>الجهة الممولة *</label>
          <select name="bank_name" id="bankSelect" class="<%= errors.bank_name ? 'invalid' : '' %>">
            <option value="">اختر...</option>
            <% BANKS.forEach(b => { %>
              <option value="<%= b %>" <%= customer && customer.bank_name===b ? 'selected':'' %>><%= b %></option>
            <% }) %>
          </select>
          <% if (errors.bank_name) { %><div class="err"><%= errors.bank_name %></div><% } %>
        </div>
        <div class="field"></div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>تاريخ البيع *</label>
          <input type="date" name="sale_date" value="<%= customer ? customer.sale_date || '' : '' %>" class="<%= errors.sale_date ? 'invalid' : '' %>" required>
          <% if (errors.sale_date) { %><div class="err"><%= errors.sale_date %></div><% } %>
        </div>
        <div class="field">
          <label>تاريخ التسليم</label>
          <input type="date" name="delivery_at" value="<%= customer ? (customer.delivery_at || '').slice(0,10) : '' %>">
          <div class="hint" id="deliveryHint">تُستخدم لحساب تذكير المتابعة بعد 24 ساعة</div>
        </div>
      </div>

      <div class="field">
        <label>نوع السيارة *</label>
        <div class="form-row" id="carPickerSelects">
          <select id="carBrand"><option value="">اختر الشركة...</option></select>
          <select id="carModel" disabled><option value="">اختر الموديل...</option></select>
          <select id="carYear" disabled><option value="">اختر السنة...</option></select>
          <select id="carTrim" disabled><option value="">اختر الفئة...</option></select>
          <select id="carColor" disabled><option value="">اختر اللون...</option></select>
        </div>
        <input type="text" id="carManualInput" placeholder="مثال: Toyota Camry 2026 GLX - أبيض" style="display:none; margin-top:8px">
        <div class="hint">
          <label><input type="checkbox" id="manualCarToggle"> السيارة مو موجودة بالقائمة (كتابة يدوية)</label>
          — أو <a href="/cars" target="_blank">أضفها لقائمة السيارات</a> وارجع حدّث هذي الصفحة
        </div>
        <input type="hidden" name="car_type" id="carTypeHidden" value="<%= customer ? customer.car_type || '' : '' %>">
        <input type="hidden" name="car_inventory_id" id="carInventoryIdHidden" value="<%= customer ? customer.car_inventory_id || '' : '' %>">
        <% if (errors.car_type) { %><div class="err"><%= errors.car_type %></div><% } %>
      </div>

      <div class="form-row">
        <div class="field">
          <label>سعر البيع (ريال)</label>
          <input type="number" step="0.01" name="price" value="<%= customer ? customer.price || '' : '' %>">
        </div>
        <div class="field"></div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>رقم هيكل السيارة VIN *</label>
          <input type="text" name="vin" style="text-transform:uppercase" value="<%= customer ? customer.vin || '' : '' %>" class="<%= errors.vin ? 'invalid' : '' %>" required>
          <% if (errors.vin) { %><div class="err"><%= errors.vin %></div><% } %>
        </div>
        <div class="field">
          <label id="labelEstimara">رقم الاستمارة *</label>
          <input type="text" name="estimara_number" id="estimaraInput" value="<%= customer ? customer.estimara_number || '' : '' %>" class="<%= errors.estimara_number ? 'invalid' : '' %>" required>
          <% if (errors.estimara_number) { %><div class="err"><%= errors.estimara_number %></div><% } %>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>اسم البائع المسؤول</label>
          <select name="salesperson">
            <option value="">غير محدد</option>
            <% salespeople.forEach(s => { %>
              <option value="<%= s %>" <%= customer && customer.salesperson===s ? 'selected':'' %>><%= s %></option>
            <% }) %>
          </select>
          <div class="hint">ما تلقى الاسم؟ <a href="/settings" target="_blank">أضفه من صفحة الإعدادات</a> وارجع حدّث هذي الصفحة</div>
        </div>
        <div class="field">
          <label>حالة العميل</label>
          <select name="status">
            <% STATUSES.forEach(s => { %>
              <option value="<%= s %>" <%= customer && customer.status===s ? 'selected':'' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="field">
        <label>ملاحظات</label>
        <textarea name="notes"><%= customer ? customer.notes || '' : '' %></textarea>
      </div>

      <% if (typeof customFields !== 'undefined' && customFields.length) { %>
        <div class="divider"></div>
        <% customFields.forEach(f => { %>
          <% const val = (typeof customValues !== 'undefined' && customValues[f.id]) || ''; %>
          <div class="field">
            <label><%= f.label %><% if (f.required) { %> *<% } %></label>
            <% if (f.field_type === 'select') { %>
              <select name="custom_<%= f.id %>" class="<%= errors['custom_'+f.id] ? 'invalid' : '' %>">
                <option value="">اختر...</option>
                <% (f.options||'').split(',').map(o=>o.trim()).filter(Boolean).forEach(opt => { %>
                  <option value="<%= opt %>" <%= val === opt ? 'selected' : '' %>><%= opt %></option>
                <% }) %>
              </select>
            <% } else if (f.field_type === 'date') { %>
              <input type="date" name="custom_<%= f.id %>" value="<%= val %>" class="<%= errors['custom_'+f.id] ? 'invalid' : '' %>">
            <% } else if (f.field_type === 'number') { %>
              <input type="number" step="any" name="custom_<%= f.id %>" value="<%= val %>" class="<%= errors['custom_'+f.id] ? 'invalid' : '' %>">
            <% } else { %>
              <input type="text" name="custom_<%= f.id %>" value="<%= val %>" class="<%= errors['custom_'+f.id] ? 'invalid' : '' %>">
            <% } %>
            <% if (errors['custom_'+f.id]) { %><div class="err"><%= errors['custom_'+f.id] %></div><% } %>
          </div>
        <% }) %>
      <% } %>

      <div class="actions-row">
        <button type="submit" class="btn btn-primary"><%= customer && customer.id ? 'حفظ التعديلات' : 'حفظ العميل' %></button>
        <% if (customer && customer.id) { %>
          <a href="/customers/<%= customer.id %>" class="btn btn-outline">إلغاء</a>
        <% } else { %>
          <a href="/customers" class="btn btn-outline">إلغاء</a>
        <% } %>
      </div>
    </form>
  </main>
  <script>
    document.querySelector('input[name="vin"]').addEventListener('input', function(){ this.value = this.value.toUpperCase(); });

    // نوع العميل: يبدّل التسميات والقيود بين بيع فردي (رخصة واستمارة) وبيع
    // لمعرض ثاني — نفس الأعمدة بقاعدة البيانات، بس قواعد مختلفة.
    const typeLicense = document.getElementById('typeLicense');
    const typeDealer = document.getElementById('typeDealer');
    const labelCustomerName = document.getElementById('labelCustomerName');
    const labelNationalId = document.getElementById('labelNationalId');
    const nationalIdInput = document.getElementById('nationalIdInput');
    const paymentSelect = document.getElementById('paymentSelect');
    const paymentDealerDisplay = document.getElementById('paymentDealerDisplay');
    const paymentDealerHidden = document.getElementById('paymentDealerHidden');
    const labelEstimara = document.getElementById('labelEstimara');
    const estimaraInput = document.getElementById('estimaraInput');
    const deliveryHint = document.getElementById('deliveryHint');
    const bankRow = document.getElementById('bankRow');
    const bankSelect = document.getElementById('bankSelect');

    // خانة "الجهة الممولة" تظهر بس لما طريقة الدفع = تمويل (وما ينطبق على
    // المعارض أصلاً، لأن طريقة دفعهم مقفولة على نقدي دائمًا).
    function updateBankVisibility() {
      const showBank = !typeDealer.checked && paymentSelect.value === 'تمويل';
      bankRow.style.display = showBank ? '' : 'none';
      bankSelect.required = showBank;
      if (!showBank) bankSelect.value = '';
    }
    paymentSelect.addEventListener('change', updateBankVisibility);

    function applyCustomerType() {
      const isDealer = typeDealer.checked;

      labelCustomerName.textContent = isDealer ? 'اسم المعرض *' : 'اسم العميل *';

      labelNationalId.textContent = isDealer ? 'رقم ال700 *' : 'رقم الهوية (10 أرقام) *';
      if (isDealer) {
        nationalIdInput.removeAttribute('maxlength');
        nationalIdInput.removeAttribute('inputmode');
      } else {
        nationalIdInput.setAttribute('maxlength', '10');
        nationalIdInput.setAttribute('inputmode', 'numeric');
      }

      paymentSelect.style.display = isDealer ? 'none' : '';
      paymentDealerDisplay.style.display = isDealer ? '' : 'none';
      paymentSelect.disabled = isDealer;
      paymentSelect.required = !isDealer;
      paymentDealerHidden.disabled = !isDealer;

      labelEstimara.textContent = isDealer ? 'رقم الاستمارة (اختياري)' : 'رقم الاستمارة *';
      estimaraInput.required = !isDealer;

      deliveryHint.style.display = isDealer ? 'none' : '';

      updateBankVisibility();
    }

    typeLicense.addEventListener('change', applyCustomerType);
    typeDealer.addEventListener('change', applyCustomerType);
    applyCustomerType();

    const CAR_INVENTORY = <%- JSON.stringify(carInventory) %>;
    const existingCustomer = <%- JSON.stringify(customer || null) %>;

    const brandSel = document.getElementById('carBrand');
    const modelSel = document.getElementById('carModel');
    const yearSel = document.getElementById('carYear');
    const trimSel = document.getElementById('carTrim');
    const colorSel = document.getElementById('carColor');
    const selectsWrap = document.getElementById('carPickerSelects');
    const manualToggle = document.getElementById('manualCarToggle');
    const manualInput = document.getElementById('carManualInput');
    const hiddenType = document.getElementById('carTypeHidden');
    const hiddenInvId = document.getElementById('carInventoryIdHidden');

    function uniqueBy(list, key) { return [...new Set(list.map(i => i[key]))]; }
    function fillSelect(sel, values, placeholder) {
      sel.innerHTML = '<option value="">' + placeholder + '</option>' +
        values.map(v => '<option value="' + v + '">' + v + '</option>').join('');
    }
    function resetFrom(level) {
      if (level <= 1) { modelSel.disabled = true; fillSelect(modelSel, [], 'اختر الموديل...'); }
      if (level <= 2) { yearSel.disabled = true; fillSelect(yearSel, [], 'اختر السنة...'); }
      if (level <= 3) { trimSel.disabled = true; fillSelect(trimSel, [], 'اختر الفئة...'); }
      if (level <= 4) { colorSel.disabled = true; fillSelect(colorSel, [], 'اختر اللون...'); }
      hiddenType.value = '';
      hiddenInvId.value = '';
    }

    fillSelect(brandSel, uniqueBy(CAR_INVENTORY, 'brand'), 'اختر الشركة...');

    brandSel.addEventListener('change', () => {
      resetFrom(1);
      if (!brandSel.value) return;
      const models = uniqueBy(CAR_INVENTORY.filter(c => c.brand === brandSel.value), 'model');
      fillSelect(modelSel, models, 'اختر الموديل...');
      modelSel.disabled = false;
    });

    modelSel.addEventListener('change', () => {
      resetFrom(2);
      if (!modelSel.value) return;
      const years = uniqueBy(CAR_INVENTORY.filter(c => c.brand === brandSel.value && c.model === modelSel.value), 'year');
      fillSelect(yearSel, years, 'اختر السنة...');
      yearSel.disabled = false;
    });

    yearSel.addEventListener('change', () => {
      resetFrom(3);
      if (!yearSel.value) return;
      const trims = uniqueBy(CAR_INVENTORY.filter(c => c.brand === brandSel.value && c.model === modelSel.value && c.year === yearSel.value), 'trim');
      fillSelect(trimSel, trims, 'اختر الفئة...');
      trimSel.disabled = false;
    });

    trimSel.addEventListener('change', () => {
      resetFrom(4);
      if (!trimSel.value) return;
      const colors = uniqueBy(CAR_INVENTORY.filter(c => c.brand === brandSel.value && c.model === modelSel.value && c.year === yearSel.value && c.trim === trimSel.value), 'color');
      fillSelect(colorSel, colors, 'اختر اللون...');
      colorSel.disabled = false;
    });

    colorSel.addEventListener('change', () => {
      if (!colorSel.value) { hiddenType.value = ''; hiddenInvId.value = ''; return; }
      const match = CAR_INVENTORY.find(c => c.brand === brandSel.value && c.model === modelSel.value && c.year === yearSel.value && c.trim === trimSel.value && c.color === colorSel.value);
      hiddenType.value = brandSel.value + ' ' + modelSel.value + ' ' + yearSel.value + ' ' + trimSel.value + ' - ' + colorSel.value;
      hiddenInvId.value = match ? match.id : '';
    });

    manualToggle.addEventListener('change', () => {
      if (manualToggle.checked) {
        selectsWrap.style.display = 'none';
        manualInput.style.display = '';
        hiddenInvId.value = '';
        hiddenType.value = manualInput.value;
      } else {
        manualInput.style.display = 'none';
        selectsWrap.style.display = '';
        hiddenType.value = '';
      }
    });
    manualInput.addEventListener('input', () => { hiddenType.value = manualInput.value; });

    // Pre-fill when editing an existing sale (or re-showing the form after a validation error)
    if (existingCustomer) {
      const invId = existingCustomer.car_inventory_id;
      const match = invId ? CAR_INVENTORY.find(c => String(c.id) === String(invId)) : null;
      if (match) {
        brandSel.value = match.brand; brandSel.dispatchEvent(new Event('change'));
        modelSel.value = match.model; modelSel.dispatchEvent(new Event('change'));
        yearSel.value = String(match.year); yearSel.dispatchEvent(new Event('change'));
        trimSel.value = match.trim; trimSel.dispatchEvent(new Event('change'));
        colorSel.value = match.color; colorSel.dispatchEvent(new Event('change'));
      } else if (existingCustomer.car_type) {
        manualToggle.checked = true;
        manualToggle.dispatchEvent(new Event('change'));
        manualInput.value = existingCustomer.car_type;
        hiddenType.value = existingCustomer.car_type;
      }
    }
  </script>
</body>
</html>
