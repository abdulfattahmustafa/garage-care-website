<!doctype html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', { title: customer && customer.id ? 'تعديل عميل' : 'إضافة عملية بيع' }) %></head>
<body>
  <%- include('../partials/nav', { active: 'new' }) %>
  <main class="page container">
    <div class="section-title"><span class="bar"></span> <%= customer && customer.id ? 'تعديل بيانات عملية البيع' : 'إضافة عملية بيع جديدة' %></div>

    <form class="card" method="POST" action="<%= customer && customer.id ? '/customers/' + customer.id : '/customers' %>">
      <div class="form-row">
        <div class="field">
          <label>اسم العميل *</label>
          <input type="text" name="customer_name" value="<%= customer ? customer.customer_name || '' : '' %>" class="<%= errors.customer_name ? 'invalid' : '' %>" required>
          <% if (errors.customer_name) { %><div class="err"><%= errors.customer_name %></div><% } %>
        </div>
        <div class="field">
          <label>رقم الهوية (10 أرقام) *</label>
          <input type="text" name="national_id" inputmode="numeric" maxlength="10" value="<%= customer ? customer.national_id || '' : '' %>" class="<%= errors.national_id ? 'invalid' : '' %>" required>
          <% if (errors.national_id) { %><div class="err"><%= errors.national_id %></div><% } %>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>رقم جوال العميل (05xxxxxxxx)</label>
          <input type="text" name="phone" inputmode="numeric" maxlength="10" value="<%= customer ? customer.phone || '' : '' %>" class="<%= errors.phone ? 'invalid' : '' %>">
          <% if (errors.phone) { %><div class="err"><%= errors.phone %></div><% } %>
        </div>
        <div class="field">
          <label>طريقة الدفع *</label>
          <select name="payment_method" class="<%= errors.payment_method ? 'invalid' : '' %>" required>
            <option value="">اختر...</option>
            <% PAYMENT_METHODS.forEach(m => { %>
              <option value="<%= m %>" <%= customer && customer.payment_method===m ? 'selected':'' %>><%= m %></option>
            <% }) %>
          </select>
          <% if (errors.payment_method) { %><div class="err"><%= errors.payment_method %></div><% } %>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>تاريخ البيع *</label>
          <input type="date" name="sale_date" value="<%= customer ? customer.sale_date || '' : '' %>" class="<%= errors.sale_date ? 'invalid' : '' %>" required>
          <% if (errors.sale_date) { %><div class="err"><%= errors.sale_date %></div><% } %>
        </div>
        <div class="field">
          <label>وقت التسليم</label>
          <input type="datetime-local" name="delivery_at" value="<%= customer ? (customer.delivery_at || '').slice(0,16) : '' %>">
          <div class="hint">تُستخدم لحساب تذكير المتابعة بعد 24 ساعة</div>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>نوع السيارة (الماركة + الموديل + سنة الصنع) *</label>
          <input type="text" name="car_type" placeholder="مثال: Toyota Camry 2026" value="<%= customer ? customer.car_type || '' : '' %>" class="<%= errors.car_type ? 'invalid' : '' %>" required>
          <% if (errors.car_type) { %><div class="err"><%= errors.car_type %></div><% } %>
        </div>
        <div class="field">
          <label>سعر البيع (ريال)</label>
          <input type="number" step="0.01" name="price" value="<%= customer ? customer.price || '' : '' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>رقم هيكل السيارة VIN (17 خانة) *</label>
          <input type="text" name="vin" maxlength="17" style="text-transform:uppercase" value="<%= customer ? customer.vin || '' : '' %>" class="<%= errors.vin ? 'invalid' : '' %>" required>
          <% if (errors.vin) { %><div class="err"><%= errors.vin %></div><% } %>
        </div>
        <div class="field">
          <label>رقم الاستمارة *</label>
          <input type="text" name="estimara_number" value="<%= customer ? customer.estimara_number || '' : '' %>" class="<%= errors.estimara_number ? 'invalid' : '' %>" required>
          <% if (errors.estimara_number) { %><div class="err"><%= errors.estimara_number %></div><% } %>
        </div>
      </div>

      <div class="form-row">
        <div class="field">
          <label>اسم البائع المسؤول</label>
          <select name="salesperson">
            <option value="">غير محدد</option>
            <% salespeople.forEach(s => { %>
              <option value="<%= s %>" <%= customer && customer.salesperson===s ? 'selected':'' %>><%= s %></option>
            <% }) %>
          </select>
          <div class="hint">ما تلقى الاسم؟ <a href="/settings" target="_blank">أضفه من صفحة الإعدادات</a> وارجع حدّث هذي الصفحة</div>
        </div>
        <div class="field">
          <label>حالة العميل</label>
          <select name="status">
            <% STATUSES.forEach(s => { %>
              <option value="<%= s %>" <%= customer && customer.status===s ? 'selected':'' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="field">
        <label>ملاحظات</label>
        <textarea name="notes"><%= customer ? customer.notes || '' : '' %></textarea>
      </div>

      <div class="actions-row">
        <button type="submit" class="btn btn-primary"><%= customer && customer.id ? 'حفظ التعديلات' : 'حفظ العميل' %></button>
        <a href="<%= customer && customer.id ? '/customers/' + customer.id : '/customers' %>" class="btn btn-outline">إلغاء</a>
      </div>
    </form>
  </main>
  <script>
    document.querySelector('input[name="vin"]').addEventListener('input', function(){ this.value = this.value.toUpperCase(); });
  </script>
</body>
</html>
