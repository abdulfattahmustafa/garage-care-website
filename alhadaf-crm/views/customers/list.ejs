<!doctype html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', { title: isDealerSection ? 'المعارض' : 'العملاء' }) %></head>
<body>
  <%- include('../partials/nav', { active: isDealerSection ? 'dealers' : 'customers' }) %>
  <main class="page container">
    <% const basePath = isDealerSection ? '/customers/dealers' : '/customers'; %>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:16px">
      <div class="section-title" style="margin:0"><span class="bar"></span> <%= isDealerSection ? 'المعارض' : 'العملاء' %> (<%= total %>)</div>
      <div style="display:flex; gap:10px">
        <% if (userRole === 'manager') { %>
        <a href="/data/export.csv?q=<%= encodeURIComponent(q) %>&payment_method=<%= encodeURIComponent(payment_method) %>&salesperson=<%= encodeURIComponent(salesperson) %>&month=<%= encodeURIComponent(month) %>&status=<%= encodeURIComponent(status) %>&customer_type=<%= encodeURIComponent(isDealerSection ? 'معارض' : 'رخصة واستمارة') %>" class="btn btn-outline">⬇️ تصدير النتائج Excel/CSV</a>
        <% } %>
        <a href="/customers/new<%= isDealerSection ? '?type=dealer' : '' %>" class="btn btn-primary">+ <%= isDealerSection ? 'إضافة معرض' : 'إضافة عملية بيع' %></a>
      </div>
    </div>

    <form class="filters" method="GET" action="<%= basePath %>">
      <input type="text" name="q" placeholder="بحث بالاسم، الهوية، VIN، الاستمارة، الجوال، السيارة..." value="<%= q %>">
      <select name="payment_method">
        <option value="">كل طرق الدفع</option>
        <% PAYMENT_METHODS.forEach(m => { %>
          <option value="<%= m %>" <%= payment_method===m?'selected':'' %>><%= m %></option>
        <% }) %>
      </select>
      <select name="salesperson">
        <option value="">كل البائعين</option>
        <% salespeople.forEach(s => { %>
          <option value="<%= s %>" <%= salesperson===s?'selected':'' %>><%= s %></option>
        <% }) %>
      </select>
      <select name="status">
        <option value="">كل الحالات</option>
        <% STATUSES.forEach(s => { %>
          <option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option>
        <% }) %>
      </select>
      <input type="month" name="month" value="<%= month %>">
      <button type="submit" class="btn btn-primary btn-sm">بحث</button>
      <a href="<%= basePath %>" class="btn btn-outline btn-sm">تفريغ</a>
    </form>

    <% function sortLink(col, label) {
      const newDir = (sort === col && dir === 'asc') ? 'desc' : 'asc';
      const qs = `q=${encodeURIComponent(q)}&payment_method=${encodeURIComponent(payment_method)}&salesperson=${encodeURIComponent(salesperson)}&month=${encodeURIComponent(month)}&status=${encodeURIComponent(status)}&sort=${col}&dir=${newDir}`;
      const arrow = sort === col ? (dir === 'asc' ? ' ▲' : ' ▼') : '';
      return `<a href="${basePath}?${qs}">${label}${arrow}</a>`;
    } %>

    <% if (!rows.length) { %>
      <div class="empty-state">لا يوجد <%= isDealerSection ? 'معارض' : 'عملاء' %> مطابقين لبحثك.</div>
    <% } else { %>
    <div class="table-wrap card" style="padding:0">
      <table>
        <thead>
          <tr>
            <th><%- sortLink('customer_name', isDealerSection ? 'اسم المعرض' : 'الاسم') %></th>
            <th><%= isDealerSection ? 'رقم ال700' : 'الهوية' %></th>
            <th><%- sortLink('sale_date', 'تاريخ البيع') %></th>
            <th><%- sortLink('car_type', 'السيارة') %></th>
            <th>الجوال</th>
            <th>البائع</th>
            <th><%- sortLink('status', 'الحالة') %></th>
            <th>التبليغ</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(c => { %>
            <tr onclick="location.href='/customers/<%= c.id %>'" style="cursor:pointer">
              <td><%= c.customer_name %></td>
              <td><%= c.national_id %></td>
              <td><%= c.sale_date %></td>
              <td><%= c.car_type %></td>
              <td><%= c.phone || '—' %></td>
              <td><%= c.salesperson || '—' %></td>
              <td><span class="badge badge-gray"><%= c.status %></span></td>
              <td>
                <% if (c.reported) { %>
                  <span class="badge badge-green">تم</span>
                <% } else if (isReportOverdue(c)) { %>
                  <span class="badge badge-red">متأخر</span>
                <% } else { %>
                  <span class="badge badge-amber">لم يُبلَّغ</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <% const qs = `q=${encodeURIComponent(q)}&payment_method=${encodeURIComponent(payment_method)}&salesperson=${encodeURIComponent(salesperson)}&month=${encodeURIComponent(month)}&status=${encodeURIComponent(status)}&sort=${sort}&dir=${dir}&page=${p}`; %>
          <% if (p === page) { %>
            <span class="current"><%= p %></span>
          <% } else { %>
            <a href="<%= basePath %>?<%= qs %>"><%= p %></a>
          <% } %>
        <% } %>
      </div>
    <% } %>
    <% } %>
  </main>
</body>
</html>
