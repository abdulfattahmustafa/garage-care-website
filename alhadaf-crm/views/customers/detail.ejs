<!doctype html>
<html lang="ar" dir="rtl">
<head><%- include('../partials/head', { title: customer.customer_name }) %></head>
<body>
  <%- include('../partials/nav', { active: customer.customer_type === 'معارض' ? 'dealers' : 'customers' }) %>
  <main class="page container">

    <% if (uploadError) { %><div class="flash flash-error"><%= uploadError %></div><% } %>

    <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px; margin-bottom:16px">
      <div class="section-title" style="margin:0">
        <span class="bar"></span> <%= customer.customer_name %>
        <% if (customer.customer_type === 'معارض') { %><span class="badge badge-gray" style="margin-right:8px">معارض</span><% } %>
      </div>
      <div style="display:flex; gap:8px; flex-wrap:wrap">
        <% const waText = encodeURIComponent(`مرحباً ${customer.customer_name}، معك ${typeof tenantName !== 'undefined' && tenantName ? tenantName : 'المعرض'} بخصوص سيارتك ${customer.car_type}. `); %>
        <% if (customer.phone) { %>
          <a class="btn btn-wa btn-sm" target="_blank" href="https://wa.me/966<%= customer.phone.replace(/^0/,'') %>?text=<%= waText %>">📲 واتساب</a>
        <% } %>
        <a class="btn btn-outline btn-sm" href="/customers/<%= customer.id %>/edit">✏️ تعديل</a>
        <form method="POST" action="/customers/<%= customer.id %>/delete" onsubmit="return confirm('هل أنت متأكد من حذف بيانات هذا العميل نهائيًا؟');" style="display:inline">
          <button type="submit" class="btn btn-danger btn-sm">🗑️ حذف</button>
        </form>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card">
        <div class="section-title" style="font-size:16px"><span class="bar"></span> بيانات العميل والسيارة</div>
        <div class="detail-grid">
          <div><div class="k"><%= customer.customer_type === 'معارض' ? 'رقم ال700' : 'رقم الهوية' %></div><div class="v"><%= customer.national_id %></div></div>
          <div><div class="k">الجوال</div><div class="v"><%= customer.phone || '—' %></div></div>
          <div><div class="k">تاريخ البيع</div><div class="v"><%= customer.sale_date %></div></div>
          <div><div class="k">تاريخ التسليم</div><div class="v"><%= customer.delivery_at ? customer.delivery_at.replace('T',' ') : '—' %></div></div>
          <div><div class="k">نوع السيارة</div><div class="v"><%= customer.car_type %></div></div>
          <div><div class="k">سعر البيع</div><div class="v"><%= customer.price ? Number(customer.price).toLocaleString('en-US') + ' ريال' : '—' %></div></div>
          <div><div class="k">رقم الهيكل VIN</div><div class="v"><%= customer.vin %></div></div>
          <div><div class="k">رقم الاستمارة</div><div class="v"><%= customer.estimara_number || '—' %></div></div>
          <div><div class="k">طريقة الدفع</div><div class="v"><%= customer.payment_method %></div></div>
          <% if (customer.bank_name) { %>
            <div><div class="k">الجهة الممولة</div><div class="v"><%= customer.bank_name %></div></div>
          <% } %>
          <div><div class="k">البائع المسؤول</div><div class="v"><%= customer.salesperson || '—' %></div></div>
          <div><div class="k">الحالة</div><div class="v"><span class="badge badge-gray"><%= customer.status %></span></div></div>
        </div>
        <% if (customer.notes) { %>
          <div class="divider"></div>
          <div class="k">ملاحظات</div>
          <div class="v" style="font-weight:400"><%= customer.notes %></div>
        <% } %>
        <div class="divider"></div>
        <p class="muted" style="font-size:12px">
          أضافه: <%= customer.created_by || '—' %> · <%= customer.created_at.slice(0,10) %>
          <% if (customer.updated_by && customer.updated_at !== customer.created_at) { %>
            · آخر تعديل: <%= customer.updated_by %> · <%= customer.updated_at.slice(0,10) %>
          <% } %>
        </p>
      </div>

      <div class="card">
        <div class="section-title" style="font-size:16px"><span class="bar"></span> حالة المستحقات</div>

        <p><strong>تبليغ المبيعات:</strong>
          <% if (customer.reported) { %>
            <span class="badge badge-green">تم التبليغ بتاريخ <%= customer.reported_at ? customer.reported_at.slice(0,10) : '' %></span>
          <% } else if (isReportOverdue(customer)) { %>
            <span class="badge badge-red">متأخر عن الموعد النهائي</span>
          <% } else { %>
            <span class="badge badge-amber">لم يُبلَّغ بعد</span>
          <% } %>
        </p>
        <form method="POST" action="/customers/<%= customer.id %>/report">
          <button type="submit" class="btn btn-outline btn-sm"><%= customer.reported ? 'التراجع عن التبليغ' : 'وضع علامة "تم التبليغ"' %></button>
        </form>

        <% if (customer.customer_type !== 'معارض') { %>
        <div class="divider"></div>

        <p><strong>متابعة ما بعد البيع:</strong>
          <% if (customer.followup_done) { %>
            <span class="badge <%= customer.followup_result === 'راضٍ' ? 'badge-green' : 'badge-red' %>"><%= customer.followup_result || 'تمت المتابعة' %></span>
          <% } else { %>
            <span class="badge badge-amber">لم تتم بعد</span>
          <% } %>
        </p>
        <% if (customer.followup_note) { %><p class="muted" style="font-size:13px"><%= customer.followup_note %></p><% } %>
        <% if (!customer.followup_done) { %>
        <form method="POST" action="/customers/<%= customer.id %>/followup">
          <div class="form-row">
            <div class="field">
              <label>نتيجة المتابعة</label>
              <select name="followup_result" required>
                <option value="راضٍ">راضٍ</option>
                <option value="غير راضٍ">غير راضٍ</option>
              </select>
            </div>
          </div>
          <div class="field"><label>ملاحظة</label><textarea name="followup_note" placeholder="تفاصيل المكالمة..."></textarea></div>
          <button type="submit" class="btn btn-primary btn-sm">تسجيل نتيجة المتابعة</button>
        </form>
        <% } %>
        <% } %>
      </div>
    </div>

    <div class="card" style="margin-top:20px">
      <div class="section-title" style="font-size:16px"><span class="bar"></span> المرفقات</div>

      <form method="POST" action="/customers/<%= customer.id %>/attachments" enctype="multipart/form-data" class="form-row" style="align-items:flex-end">
        <div class="field" style="flex:1 1 160px">
          <label>نوع المستند</label>
          <select name="label">
            <option value="صورة الهوية">صورة الهوية</option>
            <option value="العقد">العقد</option>
            <option value="شهادة الضمان">شهادة الضمان</option>
            <option value="أخرى">أخرى</option>
          </select>
        </div>
        <div class="field" style="flex:1 1 220px">
          <label>الملف (صورة أو PDF، أقل من 10 ميقابايت)</label>
          <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp,.heic,.heif,.pdf,image/jpeg,image/jpg,image/png,image/webp,image/heic,image/heif,application/pdf" required>
        </div>
        <div class="field" style="flex:0 0 auto">
          <button type="submit" class="btn btn-primary">رفع</button>
        </div>
      </form>

      <div class="divider"></div>

      <% if (!attachments.length) { %>
        <p class="muted">لا يوجد مرفقات بعد.</p>
      <% } %>
      <% attachments.forEach(a => { %>
        <div class="log-item" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px">
          <div>
            <span class="badge badge-gray"><%= a.label %></span>
            <span style="margin-right:8px"><%= a.original_name %></span>
            <span class="muted" style="font-size:12px">— <%= (a.size/1024).toFixed(0) %> كيلوبايت · <%= a.uploaded_by || '—' %> · <%= a.created_at.slice(0,10) %></span>
          </div>
          <div style="display:flex; gap:6px">
            <a class="btn btn-outline btn-sm" href="/customers/<%= customer.id %>/attachments/<%= a.id %>/download">⬇️ تنزيل</a>
            <form method="POST" action="/customers/<%= customer.id %>/attachments/<%= a.id %>/delete" onsubmit="return confirm('حذف هذا المرفق؟');">
              <button type="submit" class="btn btn-danger btn-sm">حذف</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

  </main>
</body>
</html>
