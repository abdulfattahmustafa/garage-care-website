<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <%- include('partials/head', { title: 'تعيين كلمة مرور جديدة' }) %>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="logo-mark"></div>
      <h1>تعيين كلمة مرور جديدة</h1>
      <% if (done) { %>
        <div class="flash flash-success">تم تغيير كلمة المرور بنجاح.</div>
        <p class="sub" style="margin-top:16px"><a href="/login">تسجيل الدخول</a></p>
      <% } else { %>
        <% if (error) { %>
          <div class="flash flash-error"><%= error %></div>
          <p class="sub" style="margin-top:16px"><a href="/forgot-password">اطلب رابط جديد</a></p>
        <% } else { %>
          <form method="POST" action="/reset-password">
            <input type="hidden" name="tenant" value="<%= tenant %>">
            <input type="hidden" name="token" value="<%= token %>">
            <div class="field" style="text-align:right">
              <label>كلمة المرور الجديدة</label>
              <input type="password" name="password" required autofocus placeholder="4 خانات على الأقل">
            </div>
            <button type="submit" class="btn btn-primary">حفظ كلمة المرور</button>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>
</body>
</html>
