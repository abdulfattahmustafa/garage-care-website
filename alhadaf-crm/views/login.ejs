<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <%- include('partials/head', { title: 'تسجيل الدخول' }) %>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="logo-mark"></div>
      <h1>نظام إدارة علاقات العملاء</h1>
      <p class="sub">تسجيل الدخول لمعرضك</p>
      <% if (error) { %>
        <div class="flash flash-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/login">
        <div class="field" style="text-align:right">
          <label>رمز المعرض</label>
          <input type="text" name="tenant" value="<%= tenant %>" required autofocus autocapitalize="off" autocorrect="off">
        </div>
        <div class="field" style="text-align:right">
          <label>اسم المستخدم</label>
          <input type="text" name="username" required autocapitalize="off" autocorrect="off">
        </div>
        <div class="field" style="text-align:right">
          <label>كلمة المرور</label>
          <input type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary">دخول</button>
      </form>
      <p class="sub" style="margin-top:16px"><a href="/forgot-password">نسيت كلمة المرور؟</a></p>
      <p class="sub" style="margin-top:4px">معرض جديد؟ <a href="/signup">أنشئ حساب معرضك</a></p>
    </div>
  </div>
</body>
</html>
