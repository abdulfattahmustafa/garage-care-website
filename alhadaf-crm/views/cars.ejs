<!doctype html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', { title: 'قائمة السيارات' }) %></head>
<body>
  <%- include('partials/nav', { active: 'cars' }) %>
  <main class="page container">
    <div class="section-title"><span class="bar"></span> قائمة السيارات</div>

    <div class="card">
      <p class="muted">هذي القائمة تظهر كاقتراحات عند إضافة عملية بيع (تختار الشركة، ثم الموديل، ثم السنة، ثم الفئة، ثم اللون). السعر المسجّل هنا هو <strong>سعر الشراء</strong> (اللي المعرض اشترى فيه السيارة)، وليس سعر البيع للعميل.</p>

      <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

      <form method="POST" action="/cars" id="carForm" class="form-row" style="align-items:flex-end; margin-top:14px">
        <div class="field" style="flex:1 1 140px">
          <label>الشركة</label>
          <input type="text" name="brand" id="f_brand" placeholder="مثال: Toyota" required>
        </div>
        <div class="field" style="flex:1 1 140px">
          <label>الموديل</label>
          <input type="text" name="model" id="f_model" placeholder="مثال: Camry" required>
        </div>
        <div class="field" style="flex:0 0 100px">
          <label>السنة</label>
          <input type="text" name="year" id="f_year" placeholder="2026" required>
        </div>
        <div class="field" style="flex:1 1 130px">
          <label>الفئة</label>
          <input type="text" name="trim" id="f_trim" placeholder="مثال: GLX" required>
        </div>
        <div class="field" style="flex:1 1 120px">
          <label>اللون</label>
          <input type="text" name="color" id="f_color" placeholder="مثال: أبيض" required>
        </div>
        <div class="field" style="flex:0 0 160px">
          <label>سعر الشراء (ريال)</label>
          <input type="number" step="0.01" name="purchase_price" id="f_price" placeholder="اختياري">
        </div>
        <div class="field" style="flex:0 0 auto">
          <button type="submit" class="btn btn-primary" id="carFormSubmit">+ إضافة</button>
          <a href="#" id="carFormCancel" class="btn btn-outline" style="display:none">إلغاء</a>
        </div>
      </form>
      <p class="muted" style="font-size:12px; margin-top:6px">تعديل سيارة هنا ما يغيّر نوع السيارة المسجّل بعمليات البيع القديمة اللي اخترتها من قبل — بس يصلّح القائمة والاختيارات الجديدة الجاية.</p>

      <div class="divider"></div>

      <% if (!cars.length) { %>
        <p class="muted">لا يوجد سيارات مضافة بعد.</p>
      <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>الشركة</th><th>الموديل</th><th>السنة</th><th>الفئة</th><th>اللون</th><th>سعر الشراء</th><th></th></tr></thead>
          <tbody>
            <% cars.forEach(c => { %>
              <tr>
                <td><%= c.brand %></td>
                <td><%= c.model %></td>
                <td><%= c.year %></td>
                <td><%= c.trim || '—' %></td>
                <td><%= c.color %></td>
                <td><%= c.purchase_price ? Number(c.purchase_price).toLocaleString('en-US') + ' ريال' : '—' %></td>
                <td style="display:flex; gap:6px; flex-wrap:wrap">
                  <button type="button" class="btn btn-outline btn-sm edit-car-btn" data-car="<%= JSON.stringify(c) %>">تعديل</button>
                  <form method="POST" action="/cars/<%= c.id %>/delete" onsubmit="return confirm('حذف «<%= c.brand %> <%= c.model %> <%= c.year %> <%= c.trim %> - <%= c.color %>» من القائمة؟ (عمليات البيع القديمة المرتبطة فيها تبقى كما هي)');">
                    <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </main>
  <script>
    const carForm = document.getElementById('carForm');
    const carFormSubmit = document.getElementById('carFormSubmit');
    const carFormCancel = document.getElementById('carFormCancel');

    document.querySelectorAll('.edit-car-btn').forEach(btn => {
      btn.addEventListener('click', () => editCar(JSON.parse(btn.dataset.car)));
    });

    function editCar(c) {
      carForm.action = '/cars/' + c.id;
      document.getElementById('f_brand').value = c.brand;
      document.getElementById('f_model').value = c.model;
      document.getElementById('f_year').value = c.year;
      document.getElementById('f_trim').value = c.trim || '';
      document.getElementById('f_color').value = c.color;
      document.getElementById('f_price').value = c.purchase_price || '';
      carFormSubmit.textContent = 'حفظ التعديل';
      carFormCancel.style.display = '';
      carForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    carFormCancel.addEventListener('click', (ev) => {
      ev.preventDefault();
      carForm.action = '/cars';
      carForm.reset();
      carFormSubmit.textContent = '+ إضافة';
      carFormCancel.style.display = 'none';
    });
  </script>
</body>
</html>
