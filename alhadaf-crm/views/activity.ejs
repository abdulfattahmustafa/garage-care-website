<!doctype html>
<html lang="ar" dir="rtl">
<head><%- include('partials/head', { title: 'سجل النشاط' }) %></head>
<body>
  <%- include('partials/nav', { active: 'activity' }) %>
  <main class="page container">
    <div class="section-title"><span class="bar"></span> سجل النشاط (<%= total %>)</div>

    <form class="filters" method="GET" action="/activity">
      <input type="text" name="q" placeholder="بحث بنوع العملية أو التفاصيل..." value="<%= q %>">
      <select name="user">
        <option value="">كل المستخدمين</option>
        <% users.forEach(u => { %>
          <option value="<%= u %>" <%= user===u?'selected':'' %>><%= u %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">بحث</button>
      <a href="/activity" class="btn btn-outline btn-sm">تفريغ</a>
    </form>

    <% if (!rows.length) { %>
      <div class="empty-state">لا يوجد نشاط مسجّل بعد.</div>
    <% } else { %>
    <div class="table-wrap card" style="padding:0">
      <table>
        <thead>
          <tr><th>الوقت</th><th>المستخدم</th><th>العملية</th><th>التفاصيل</th></tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
            <tr>
              <td><%= r.created_at.replace('T',' ').slice(0,16) %></td>
              <td><%= r.user_name || '—' %></td>
              <td><span class="badge badge-gray"><%= r.action %></span></td>
              <td><%= r.details || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <% const qs = `q=${encodeURIComponent(q)}&user=${encodeURIComponent(user)}&page=${p}`; %>
          <% if (p === page) { %>
            <span class="current"><%= p %></span>
          <% } else { %>
            <a href="/activity?<%= qs %>"><%= p %></a>
          <% } %>
        <% } %>
      </div>
    <% } %>
    <% } %>
  </main>
</body>
</html>
